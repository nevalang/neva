type Rec1Lvl1 struct {
    rec1Lvl2 struct {
        foo list<int>
    }
}

type Rec2Lvl1 struct  {
    rec2Lvl2 struct {
        foo list<struct {
            foo int
        }>
    }
}

type Rec3Lvl1 struct {
    rec3Lvl2 struct {
        foo list<struct {
            bar list<struct {
                baz int
            }>
        }>
    }
}

pub type Rec4Lvl1 struct {
    rec4Lvl2 struct {
        foo list<struct {
            bar list<struct {
                baz dict<string, struct { baz bool }>
            }>
        }>
    }
}
