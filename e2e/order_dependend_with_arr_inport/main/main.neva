import {
	fmt
	runtime
	streams
}

const l list<int> = [1, 2, 3]

def Main(start any) (stop any) {
	println fmt.Println<int>
	reduce streams.Reduce<int, int>{
		Sub
	}
	from_list streams.FromList<int>
	panic runtime.Panic
	---
	:start -> [
