import {
	fmt
	runtime
}

def Main(start any) (stop any) {
	int Int
	float Float
	string String
	p1 fmt.Println<any>
	p2 fmt.Println<any>
	p3 fmt.Println<any>
	panic runtime.Panic
	---
	:start -> 1.9 -> int -> p1:data
	[
		p1:err,
		p2:err,
		p3:err,
	] -> panic
	p1:res -> 42 -> float -> p2:data
	p2:res -> 42 -> string -> p3:data
	p3:res -> :stop
}
