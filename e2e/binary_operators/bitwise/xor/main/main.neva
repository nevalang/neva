import {
    fmt
    runtime
}

def Main(start any) (stop any) {
    bit_xor BitXor
    println fmt.Println<any>
    panic runtime.Panic
    ---
    :start -> [
        5 -> bit_xor:left,
        3 -> bit_xor:right
    ]
    bit_xor:res -> println
    println:res -> :stop
    println:err -> panic
}
