import {
    fmt
    lists
    runtime
}

const f int = 69
const l list<int> = [320, 420, 100, -100, 0, 5]

def Main(start any) (stop any) {
    append lists.Append<int>
    println fmt.Println<list<int>>
    panic runtime.Panic
	---
	:start -> [
		$l -> append:lst,
		$f -> append:data
	]
    append -> println:data
    println:res -> :stop
    println:err -> panic
}
