import {
	fmt
	runtime
	sync
}

type State struct {
	rate int
	balance int
	last_time int
}

// Main runs three interest calculations in sequence and prints each result.
// The state transitions are:
// 1) initial deposit,
// 2) rate update,
// 3) balance update.
def Main(start any) (stop any) {
	initial_deposit InitialDeposit
	interest_calc InterestCalc
	rate_change RateChange
	balance_change BalanceChange
	p1 fmt.Println<int>
	p2 fmt.Println<int>
	p3 fmt.Println<int>
	wait_group sync.WaitGroup
	panic runtime.Panic
	---
	:start -> [
		3 -> wait_group:count,
		5 -> initial_deposit:rate,
		1000 -> initial_deposit:balance,
		0 -> initial_deposit:now,
		1 -> interest_calc:now,
		6 -> rate_change:new_rate,
		2 -> rate_change:now,
		1200 -> balance_change:new_balance,
		3 -> balance_change:now
	]

	initial_deposit:state -> interest_calc:state
	interest_calc:state -> rate_change:state
	rate_change:state -> balance_change:state

	interest_calc:interest -> p1
	rate_change:interest -> p2
	balance_change:interest -> p3
	[p1:res, p2:res, p3:res] -> wait_group:sig
	wait_group -> :stop
	[p1:err, p2:err, p3:err] -> panic
}

// InitialDeposit creates the initial account state and emits zero interest.
def InitialDeposit(rate int, balance int, now int) (
	state State,
	interest int
) {
	builder Struct<State>
	---
	:rate -> builder:rate
	:balance -> builder:balance
	:now -> [
		builder:last_time,
		0 -> :interest
	]
	builder -> :state
}

// InterestCalc computes interest using the current state and updates last_time.
def InterestCalc(state State, now int) (state State, interest int) {
	builder Struct<State>
	compute_interest ComputeInterest
	---
	:state -> [
		compute_interest:state,
		.rate -> builder:rate,
		.balance -> builder:balance
	]
	:now -> [compute_interest:now, builder:last_time]
	compute_interest -> :interest
	builder -> :state
}

// RateChange recalculates interest and updates the account rate.
def RateChange(state State, new_rate int, now int) (
	state State,
	interest int
) {
	builder Struct<State>
	calc ComputeInterest
	---
	:state -> [
		calc:state,
		.balance -> builder:balance
	]
	:new_rate -> builder:rate
	:now -> [calc:now, builder:last_time]
	calc -> :interest
	builder -> :state
}

// BalanceChange recalculates interest and updates the account balance.
def BalanceChange(state State, new_balance int, now int) (
	state State,
	interest int
) {
	builder Struct<State>
	calc ComputeInterest
	---
	:state -> [
		calc:state,
		.rate -> builder:rate
	]
	:new_balance -> builder:balance
	:now -> [calc:now, builder:last_time]
	calc -> :interest
	builder -> :state
}

// ComputeInterest applies:
// interest = state.rate * state.balance * (now - state.last_time)
def ComputeInterest(state State, now int) (interest int) {
	sub Sub
	mul_rate_balance Mul
	mul_total Mul
	---
	:state -> [
		.rate -> mul_rate_balance:left,
		.balance -> mul_rate_balance:right,
		.last_time -> sub:right
	]
	:now -> sub:left
	mul_rate_balance -> mul_total:left
	sub -> mul_total:right
	mul_total -> :interest
}
