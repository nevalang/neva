import {
	fmt
	runtime
	streams
	strings
}

def Main(start any) (stop any) {
	println fmt.Println<string>
	split strings.Split
	join strings.Join
	from_list streams.FromList<string>
	panic runtime.Panic
	---
	:start -> [
		'neva' -> split:data,
		'' -> split:delim,
		'' -> join:sep,
	]
	split -> from_list -> join:data
	join -> println:data
	println:res -> :stop
	println:err -> panic
}
