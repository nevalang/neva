import {
    fmt
    runtime
    strings
}

def Main(start any) (stop any) {
    app App
    panic runtime.Panic
    ---
    :start -> app:start
    app:err -> panic
    app:stop -> :stop
}

// We keep :err as any to forward the unmatched string to Panic.
def App(start any) (stop any, err any) {
    print fmt.Print<any>?
    scanln fmt.Scanln?
    to_upper strings.ToUpper
    to_lower strings.ToLower
    println fmt.Println<any>?
    switch Switch<string>
    ---
    :start -> [
        'Enter the name: ' -> print -> scanln -> switch:data,
        'Alice' -> switch:case[0] -> to_upper,
        'Bob' -> switch:case[1] -> to_lower
    ]
    switch:else -> :err
    [to_upper, to_lower] -> println
    println -> :stop
}
