import {
	fmt
	http
	runtime
	strings
}

def Main(start any) (stop any) {
	get http.Get
	from_bytes strings.FromBytes
	println fmt.Println<any>
	panic runtime.Panic
	---
	:start -> 'http://www.example.com' -> get
	get:res -> .body -> from_bytes -> println
	println:res -> :stop
	[get:err, println:err] -> panic
}
